{
  "name": "vugandakumva-live",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node --test --test-timeout=120000 e2e/*.test.mjs",
    "format": "prettier --write src e2e *.ts *.json *.mjs *.html",
    "format:check": "prettier --check src e2e *.ts *.json *.mjs *.html"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "i18next": "26.5.2",
    "lucide-react": "1.52.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.1.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "lighthouse": "13.5.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  }
}
